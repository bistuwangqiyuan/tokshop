# Copy to .env.local (never commit real secrets).
# Names and purposes only — values come from Vercel / provider consoles.

# --- core ---
DATABASE_URL=
AUTH_SECRET=
APP_URL=https://tokshop.xyz
CRON_SECRET=
INDEXNOW_KEY=
AI_GATEWAY_API_KEY=

# --- Creem (global card / Apple Pay / Google Pay, merchant of record) ---
# Omit all three to hide the Creem rail. Test keys start with creem_test_.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# Set exactly "false" for live api.creem.io. Any other value uses test-api.
CREEM_TEST_MODE=

# --- XunhuPay / 虎皮椒 (Alipay / WeChat, mainland China) ---
XUNHU_APPID=
XUNHU_APPSECRET=
XUNHU_ALIPAY_APPID=
XUNHU_ALIPAY_APPSECRET=
CNY_PER_USD=7.3

# --- download delivery cookies (falls back to AUTH_SECRET) ---
DOWNLOAD_TOKEN_SECRET=

# --- AgentMail (receipts + support auto-reply) ---
# Inbox must match the published support address mingxinai@agentmail.to
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=mingxinai@agentmail.to
# Svix signing secret (whsec_…) for https://tokshop.xyz/api/webhooks/agentmail
AGENTMAIL_WEBHOOK_SECRET=
