# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eslint
.eslintcache

.vercel
.env*
!.env.example

# local test run logs
*.log
content-debug.json

# Lighthouse/PSI raw archives (summary is quoted in TEST_REPORT.md)
/psi-results/

# agent scratch plans
/.cursor/plans/

# python bytecode (reports/ ships .py sources, not build artefacts)
__pycache__/
*.py[cod]
